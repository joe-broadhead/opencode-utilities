{
  "name": "@joe-broadhead/opencode-utilities",
  "version": "0.0.1",
  "description": "Unofficial OpenCode plugin: weather, time, polled timers and local speech tools",
  "keywords": ["opencode", "opencode-plugin", "utilities"],
  "homepage": "https://github.com/joe-broadhead/opencode-utilities#readme",
  "bugs": { "url": "https://github.com/joe-broadhead/opencode-utilities/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/joe-broadhead/opencode-utilities.git" },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": ["dist", "skills", "manifest", "README.md", "LICENSE", "NOTICE", "CHANGELOG.md"],
  "opencode": { "host": ">=2.2.3 <2.3.0" },
  "workspaces": ["npm/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "build": "node scripts/build.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:tui": "bun test test/tui",
    "test:pack": "bun test test/pack",
    "lint": "node scripts/check-forbidden.mjs",
    "native:build": "bash scripts/native-build.sh",
    "native:ensure": "node scripts/native-ensure.mjs",
    "check": "npm run native:ensure && npm run typecheck && npm test && npm run build && npm run test:host && npm run test:tui && npm run lint && npm run test:pack"
  },
  "optionalDependencies": {
    "@joe-broadhead/opencode-utilities-bin-darwin-arm64": "0.0.1",
    "@joe-broadhead/opencode-utilities-bin-darwin-x64": "0.0.1",
    "@joe-broadhead/opencode-utilities-bin-linux-x64-gnu": "0.0.1",
    "@joe-broadhead/opencode-utilities-bin-linux-arm64-gnu": "0.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/util": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
