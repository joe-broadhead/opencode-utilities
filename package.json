    "skills": [
      "utilities-time",
      "utilities-weather",
      "utilities-speech"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "open-meteo",
        "label": "Open-Meteo",
        "integration": "open-meteo",
        "required": false,
        "help": {
          "url": "https://open-meteo.com/en/pricing",
          "label": "Commercial use needs a key from Open-Meteo"
        }
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
}
