{
  "name": "@we-the-rebel-alliance/utilities-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Local time, date, holiday, timer, weather and on-device speech tools for an OpenCode agent.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin-contract",
    "utilities"
  ],
  "homepage": "https://github.com/we-the-rebel-alliance/utilities-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/utilities-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/utilities-plugin.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "manifest",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "utilities",
      "title": "Utilities",
      "summary": "Time, holidays, working days, timers, Open-Meteo weather, on-device speech, and read-only past-session status and exact-text search: stopgaps until OpenCode has them. Load the utilities-time, -weather, -speech or -sessions skill for call shapes. To find a session, use opencode.session.search.",
      "vendor": {
        "id": "utilities",
        "name": "Utilities",
        "domain": "utilities.invalid"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        },
        {
          "src": "assets/icon-128.png",
          "type": "image/png"
        },
        {
          "src": "assets/icon-256.png",
          "type": "image/png"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "description": "How much the plugin's methods may do: reads always run; a change runs under all, asks under ask-changes, and is off under read-only."
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "description": "Start on an OpenCode release outside the tested range, instead of refusing with HOST_UNTESTED."
        },
        "modules": {
          "type": "object",
          "properties": {
            "time": {
              "type": "boolean",
              "default": true,
              "description": "Register the time and timer methods."
            },
            "weather": {
              "type": "boolean",
              "default": true,
              "description": "Register the weather methods."
            },
            "speech": {
              "type": "boolean",
              "default": true,
              "description": "Register the speech methods."
            }
          },
          "additionalProperties": false,
          "default": {
            "time": true,
            "weather": true,
            "speech": true
          },
          "description": "Turn a module off; its methods refuse with DISABLED and its programs are never inspected."
        },
        "stateRoot": {
          "type": "string",
          "description": "Where timers and default speech files are kept. Default: $XDG_DATA_HOME/utilities."
        },
        "speech": {
          "type": "object",
          "properties": {
            "assetsDir": {
              "type": "string",
              "description": "A folder of pre-seeded speech files, verified by SHA-256; when set, nothing is downloaded."
            }
          },
          "additionalProperties": false,
          "description": "Speech file options."
        },
        "sessionsDatabasePath": {
          "type": "string",
          "description": "OpenCode's SQLite database, opened read-only by sessions_grep. Default: $XDG_DATA_HOME/opencode/opencode.db."
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "accounts": "none"
      },
      "diagnose": {
        "class": "read",
        "accounts": "none"
      },
      "sessions": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "sessions.list"
        ]
      },
      "sessions_grep": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "sessions.database"
        ]
      },
      "time_now": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_zones": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_zone_info": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_convert": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_calendar": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_add": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_between": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_format": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_holidays": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "time_business_days": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.local"
        ]
      },
      "timer_set": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "time.timers.write"
        ]
      },
      "timer_get": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.timers.read"
        ]
      },
      "timer_list": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.timers.read"
        ]
      },
      "timer_check": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "time.timers.read"
        ]
      },
      "timer_delete": {
        "class": "delete",
        "accounts": "none",
        "operations": [
          "time.timers.delete"
        ]
      },
      "native_install": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "native.files"
        ]
      },
      "weather_geocode": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.geocode"
        ]
      },
      "weather_current": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.forecast"
        ]
      },
      "weather_daily": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.forecast"
        ]
      },
      "weather_hourly": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.forecast"
        ]
      },
      "weather_demand_signal": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.forecast"
        ]
      },
      "weather_summary": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "weather.forecast"
        ]
      },
      "speech_transcribe": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "speech.transcribe"
        ]
      },
      "speech_synthesize": {
        "class": "export",
        "accounts": "none",
        "operations": [
          "speech.synthesize"
        ]
      },
      "speech_install": {
        "class": "admin",
        "accounts": "none",
        "operations": [
          "speech.files"
        ]
      }
    },
    "sources": [],
    "actions": [],
    "events": {
      "changed": {}
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "bundle": "node scripts/build.mjs",
    "test:pack": "bun test test/pack",
    "native:build": "bash scripts/native-build.sh",
    "native:ensure": "node scripts/native-ensure.mjs",
    "speech:manifest": "node scripts/speech-manifest.mjs",
    "kit:check": "plugin-kit check",
    "check": "npm run native:ensure && npm run typecheck && npm run bundle && npm test && npm run test:pack && npm run kit:check"
  },
  "devDependencies": {
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/bun": "1.4.4",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
